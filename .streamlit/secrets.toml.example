# Copy this file to .streamlit/secrets.toml and fill in your own values.
# secrets.toml is gitignored: never commit real secrets.

# Postgres connection string (e.g. from Neon: Dashboard -> Connect -> pooled connection)
DATABASE_URL = "postgresql://user:password@your-host.neon.tech/dbname?sslmode=require"

# Free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY = "your-omdb-key"

# Optional: shared passphrase that gates the whole app. Remove to disable.
family_pin = "choose-a-long-passphrase"

# Optional: people created the first time the app starts on an empty database.
# Without this, three demo members (Alice, Bob, Chloé) are created instead.
[[family_members]]
username = "alice"
display_name = "Alice"
avatar_emoji = "🎬"

[[family_members]]
username = "bob"
display_name = "Bob"
avatar_emoji = "🍿"
